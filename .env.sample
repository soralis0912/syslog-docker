TZ=Asia/Tokyo

# --- Senders ---------------------------------------------------------------
# Space-separated "address|name". The name becomes the directory under
# data/logs and the "device" label in Loki. Anything arriving from an address
# that is not listed is filed under _unknown rather than dropped, so a typo
# here shows up as data in the wrong place instead of silence.
SYSLOG_DEVICES=192.0.2.1|edge-firewall

# --- Shipping --------------------------------------------------------------
# Alloy joins the metrics stack's network, so Loki resolves by service name and
# Prometheus can scrape Alloy back. Set METRICS_NETWORK to whatever that
# project's network is actually called (`docker network ls`).
METRICS_NETWORK=prometheus-docker_default
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# --- Local retention (Layer 2) ---------------------------------------------
# Local text is only a replay buffer for Alloy; Loki holds the long tail.
# COMPRESS_AFTER_DAYS must stay >= 2: Alloy tails the current and previous day
# and compressing under it loses the rest of the file. The script clamps it.
COMPRESS_AFTER_DAYS=2
LOCAL_RETENTION_DAYS=14
ZSTD_LEVEL=10
RETENTION_SCHEDULE=17 4 * * *

# --- Paths -----------------------------------------------------------------
# Defaults keep everything under ./data, which .gitignore excludes.
# SYSLOG_LOG_DIR=./data/logs
# SYSLOG_SPOOL_DIR=./data/spool
# ALLOY_DATA_DIR=./data/alloy
